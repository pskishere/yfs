# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis（可选，不填则使用内存 Channel Layer）
# REDIS_URL=redis://localhost:6379/0

# ---------- Agent 模型配置 ----------
# 默认：本地 Ollama
LLM_MODEL=ollama/deepseek-v3.1:671b-cloud
OLLAMA_BASE_URL=http://localhost:11434

# 切换到 Anthropic：
# LLM_MODEL=claude-sonnet-4-6
# LLM_API_KEY=sk-ant-...

# 切换到 DeepSeek API：
# LLM_MODEL=deepseek/deepseek-chat
# LLM_API_KEY=sk-...

# 切换到 OpenAI：
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-...

# 切换到 MiniMaxi（Anthropic 兼容接口）：
# LLM_MODEL=anthropic/MiniMax-M2.7
# LLM_BASE_URL=https://api.minimaxi.com/anthropic
# LLM_API_KEY=sk-cp-...

# 语义记忆（需要 chromadb，首次运行会下载 ~80MB 模型）
# LLM_VECTOR_MEMORY=true
